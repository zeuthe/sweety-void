<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="VoidUI.Views.SettingsPage">
    <ScrollViewer Background="Transparent" Padding="24,20">
        <StackPanel Spacing="20" MaxWidth="1000">

            <!-- Page header -->
            <StackPanel Spacing="4" Margin="0,0,0,4">
                <TextBlock Text="SETTINGS" FontSize="20" FontWeight="800" Foreground="{StaticResource TextPrimary}"/>
                <TextBlock Text="Appearance, overlay and data management" FontSize="12" Foreground="{StaticResource TextTertiary}"/>
            </StackPanel>

            <!-- Theme -->
            <Border Classes="section">
                <StackPanel Spacing="12">
                    <TextBlock Text="APPEARANCE" Classes="section-header"/>
                    <TextBlock Text="Theme" Foreground="{StaticResource TextSecondary}" FontSize="12" Margin="0,0,0,4"/>
                    <WrapPanel Name="ThemeWrap" Orientation="Horizontal"/>
                </StackPanel>
            </Border>

            <!-- Style -->
            <Border Classes="section">
                <StackPanel Spacing="12">
                    <TextBlock Text="STYLE" Classes="section-header"/>

                    <TextBlock Text="Font" Foreground="{StaticResource TextSecondary}" FontSize="12" Margin="0,0,0,4"/>
                    <ComboBox Name="FontStyleCombo" MinWidth="240" HorizontalAlignment="Left" FontSize="12"/>
                    <TextBlock Name="FontStylePreview" Text="Sweety Void 0123456789 — abcdef" FontSize="14"
                               Margin="0,4,0,0" Foreground="{StaticResource TextPrimary}"/>

                    <TextBlock Text="Buttons" Foreground="{StaticResource TextSecondary}" FontSize="12" Margin="0,4,0,0"/>
                    <WrapPanel Name="ButtonStyleWrap" Orientation="Horizontal" Margin="-6,0,0,0"/>

                    <TextBlock Text="Applied on top of the active theme and kept across restarts."
                               FontSize="11" Foreground="{StaticResource TextTertiary}"/>
                </StackPanel>
            </Border>

            <!-- Data -->
            <Border Classes="section">
                <StackPanel Spacing="12">
                    <TextBlock Text="DATA" Classes="section-header"/>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button Classes="action" Name="ResetAllBtn" Content="Reset All" Height="34" Padding="16,0"/>
                        <Button Classes="ghost" Name="OpenFolderBtn" Content="Open Folder"/>
                        <Button Classes="ghost" Name="ExportBtn" Content="Export Config"/>
                    </StackPanel>
                    <TextBlock Name="ExportHint" Text="" FontSize="11"
                               Foreground="{StaticResource TextTertiary}"/>
                </StackPanel>
            </Border>

            <!-- Updates -->
            <Border Classes="section">
                <StackPanel Spacing="12">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="UPDATES" Classes="section-header"/>
                        <Border Classes="new-badge"><TextBlock Text="NEW"/></Border>
                    </StackPanel>

                    <Grid ColumnDefinitions="*,Auto">
                        <StackPanel Spacing="3" VerticalAlignment="Center" Margin="0,0,12,0">
                            <TextBlock Name="UpdateStateText" Text="Checking for updates..."
                                       FontSize="13" FontWeight="600"
                                       Foreground="{StaticResource TextPrimary}"/>
                            <TextBlock Name="UpdateNotesText" Text=""
                                       FontSize="11" Foreground="{StaticResource TextTertiary}"
                                       TextWrapping="Wrap" MaxWidth="560" MaxHeight="34"
                                       TextTrimming="CharacterEllipsis"/>
                        </StackPanel>

                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8"
                                    VerticalAlignment="Center">
                            <Button Classes="ghost" Name="UpdateCheckBtn" Content="Check now"/>
                            <Button Classes="action" Name="UpdateActionBtn" Content="Download"
                                    IsVisible="False"/>
                        </StackPanel>
                    </Grid>

                    <TextBlock Text="Update mode" Foreground="{StaticResource TextSecondary}"
                               FontSize="12" Margin="0,4,0,0"/>
                    <ComboBox Name="UpdateModeCombo" MinWidth="240" HorizontalAlignment="Left"
                              FontSize="12"/>

                    <TextBlock Name="UpdateModeHint"
                               Text="Ask before download — the update is never downloaded until you confirm. Automatic — downloaded and installed on its own."
                               FontSize="11" Foreground="{StaticResource TextTertiary}"
                               TextWrapping="Wrap" MaxWidth="620"/>
                </StackPanel>
            </Border>

            <!-- About -->
            <Border Classes="section">
                <StackPanel Spacing="8">
                    <TextBlock Text="ABOUT" Classes="section-header"/>
                    <StackPanel Orientation="Horizontal" Spacing="12" Margin="0,4,0,0">
                        <TextBlock Text="Sweety Void" FontSize="16" FontWeight="700" Foreground="{StaticResource TextPrimary}"/>
                        <Border Background="{StaticResource AccentSubtle}" CornerRadius="6" Padding="8,2">
                            <TextBlock Name="VersionText" Text="v1.0.0" FontSize="10" FontWeight="600" Foreground="{StaticResource AccentDefault}"/>
                        </Border>
                    </StackPanel>
                    <TextBlock Text=".NET 8 + Avalonia UI" Foreground="{StaticResource TextTertiary}" FontSize="11"/>
                    <TextBlock Text="A comprehensive Rust configuration tool with graphics presets, crosshair overlay, keybind management, and tracker analytics."
                               Foreground="{StaticResource TextTertiary}" FontSize="11" TextWrapping="Wrap"/>
                    <TextBlock Text="License: Custom Source-Available — © 2026 zeuthe. Forks allowed with attribution; donation and sales mechanisms of the original author must stay intact."
                               Foreground="{StaticResource TextTertiary}" FontSize="11" TextWrapping="Wrap"/>
                    <Button Classes="ghost" Name="RepoLinkBtn" Content="github.com/zeuthe/void-ui"
                            AutomationProperties.AutomationId="RepoLinkBtn"
                            HorizontalAlignment="Left" Margin="0,2,0,0"/>
                </StackPanel>
            </Border>

            <StackPanel Height="24"/>
        </StackPanel>
    </ScrollViewer>
</UserControl>
