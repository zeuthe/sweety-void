<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <AssemblyName>VoidUI.Setup</AssemblyName>
    <RootNamespace>VoidUI.Installer</RootNamespace>
    <ApplicationIcon>..\assets\logo.ico</ApplicationIcon>
    <DebugType>none</DebugType>
    <Version>1.1.1</Version>
    <AvaloniaUseCompiledBindingsByDefault>false</AvaloniaUseCompiledBindingsByDefault>
  </PropertyGroup>

  <PropertyGroup>
    <PayloadZip Condition="'$(PayloadZip)' == ''">$(MSBuildThisFileDirectory)payload.zip</PayloadZip>
    <!-- SlimBuild=true builds the uninstaller variant: same wizard code, no
         app payload embedded, so the binary weighs ~15 MB instead of ~120 MB. -->
    <SlimBuild Condition="'$(SlimBuild)' == ''">false</SlimBuild>
    <!-- Path to the slim uninstaller exe; when present, the full installer
         embeds it and drops it into the install folder as Uninstall.exe. -->
    <UninstallerExe Condition="'$(UninstallerExe)' == ''"></UninstallerExe>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="11.2.3" />
    <PackageReference Include="Avalonia.Desktop" Version="11.2.3" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="11.2.3" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="11.2.3" />
  </ItemGroup>

  <ItemGroup>
    <AvaloniaResource Include="..\assets\logo.ico" Link="assets/logo.ico" />
  </ItemGroup>

  <ItemGroup Condition="'$(SlimBuild)' != 'true' and Exists('$(PayloadZip)')">
    <EmbeddedResource Include="$(PayloadZip)" LogicalName="payload.zip" />
  </ItemGroup>

  <!-- Full installer carries the slim uninstaller to drop at install time. -->
  <ItemGroup Condition="'$(UninstallerExe)' != '' and Exists('$(UninstallerExe)')">
    <EmbeddedResource Include="$(UninstallerExe)" LogicalName="uninstaller.exe" />
  </ItemGroup>

</Project>
